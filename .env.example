# Application
APP_ENV=development
PQC_ENABLED=false

# Database
POSTGRES_DB=organ_donation_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<set-locally>
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://postgres:<set-locally>@postgres:5432/organ_donation_db

# JWT Security
JWT_SECRET_KEY=<generate-a-secure-random-secret-key>
JWT_REFRESH_SECRET_KEY=<generate-a-separate-secure-random-refresh-secret-key>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Hyperledger Fabric Gateway Configuration
FABRIC_NETWORK=test-network
FABRIC_CHANNEL=organ-donation-channel
FABRIC_CHAINCODE=organ-contract
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_GATEWAY_ENDPOINT=localhost:7051
FABRIC_CERT_PATH=/path/to/fabric/crypto/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/cert.pem
FABRIC_KEY_PATH=/path/to/fabric/crypto/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore/priv_key
FABRIC_TLS_CERT_PATH=/path/to/fabric/crypto/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
