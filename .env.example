# ==============================================================================
# 2. PRODUCTION ENVIRONMENT CONFIGURATION (ACTIVE — FOR COOLIFY / DOCKER)
# ==============================================================================
# Active keys used when building and running the container in production

# Core Application Settings
APP_ENV=production
PQC_ENABLED=false
PORT=80

# Production Database Configuration
POSTGRES_DB=organ_donation_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=organmatch_secure_pass_2026
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:organmatch_secure_pass_2026@127.0.0.1:5432/organ_donation_db

# Initial Admin & Clinical User Seed Password (admin / doctor / hospital / transplant)
SEED_USER_PASSWORD=OrganMatch2026!
AUTO_SEED=true

# Cryptographically Secure Production JWT Secrets
JWT_SECRET_KEY=generate_a_secure_random_hex_key_for_production_organmatch_2026
JWT_REFRESH_SECRET_KEY=generate_a_separate_secure_random_refresh_secret_key_organmatch_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Hyperledger Fabric Gateway Configuration (Decoupled in production until Fabric peer is mounted)
FABRIC_NETWORK=organ-donation-network
FABRIC_CHANNEL=organ-donation-channel
FABRIC_CHAINCODE=organ-contract
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_GATEWAY_ENDPOINT=localhost:7051
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
FABRIC_TLS_CERT_PATH=
