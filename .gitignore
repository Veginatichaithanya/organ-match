# ==========================================
# OrganMatch Comprehensive Git Ignore
# ==========================================

# 1. Environment & Secrets

.env.*
.env.local
.env.development
.env.production
!.env.example
*.env

# 2. Python Environments & Caches
__pycache__/
*.py[cod]
*$py.class
*.pyc
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# 3. Node.js & Frontend Builds
node_modules/
dist/
dist-ssr/
build/
.eslintcache
.prettiercache
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 4. Hyperledger Fabric Crypto, Keys & Artifacts
